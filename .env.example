NODE_ENV=development
PORT=3000
DATABASE_URL=file:./data/role-auth.db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Run `npm run admin:bootstrap` once before allowing public registration.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
